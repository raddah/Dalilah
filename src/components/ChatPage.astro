---
import ChatShell from "./ChatShell";
import "../styles/global.css";
import "../styles/site.css";

type Locale = "ar" | "en";

interface Props {
  locale: Locale;
  query?: string | null;
}

const { locale, query } = Astro.props;
const isArabic = locale === "ar";
const aboutPath = isArabic ? "/ar/about/" : "/en/about/";
---

<!doctype html>
<html lang={locale} dir={isArabic ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{isArabic ? "اسأل دليلة" : "Ask Dalilah"}</title>
  </head>
  <body>
    <main class="chat-page">
      <header class:list={["site-header", "chat-page-header", { "is-arabic": isArabic }]}>
        <a href={isArabic ? "/ar/" : "/en/"} class="brand-lockup">
          <img src="/brand/Dalilah_main_logo.svg" alt="Dalilah" />
        </a>
        <nav
          class:list={["site-nav", { "is-arabic": isArabic }]}
          aria-label={isArabic ? "التنقل الرئيسي" : "Main navigation"}
        >
          <a href={isArabic ? "/ar/chat/" : "/en/chat/"}>{isArabic ? "اسأل دليلة" : "Ask Dalilah"}</a>
          <a href={aboutPath}>{isArabic ? "عن دليلة" : "About"}</a>
        </nav>
        <a
          class="language-switch"
          href={isArabic ? "/en/chat/" : "/ar/chat/"}
          aria-label={isArabic ? "Switch to English" : "التبديل إلى العربية"}
          title={isArabic ? "Switch to English" : "التبديل إلى العربية"}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="8.5"></circle>
            <path d="M3.8 12h16.4M12 3.5c2.2 2.3 3.3 5.1 3.3 8.5s-1.1 6.2-3.3 8.5c-2.2-2.3-3.3-5.1-3.3-8.5S9.8 5.8 12 3.5Z"></path>
          </svg>
        </a>
      </header>
      <section class="chat-page-content">
        <p class="eyebrow">D A L I L A H · {isArabic ? "محادثة ذكية" : "AI CONVERSATION"}</p>
        <h1>{isArabic ? "اسأل دليلة" : "Ask Dalilah"}</h1>
        <ChatShell language={locale} initialMessage={query ?? ""} client:load />
      </section>
      <footer class:list={["site-footer", { "is-arabic": isArabic }]}>
        <span>{isArabic ? "دليل دليلة للتراث © 2026" : "Dalilah Heritage Guide © 2026"}</span>
        <div>
          <a href={isArabic ? "/ar/#sources" : "/en/#sources"}>{isArabic ? "المصادر" : "Sources"}</a>
          <a href={isArabic ? "/ar/#privacy" : "/en/#privacy"}>{isArabic ? "الخصوصية" : "Privacy"}</a>
          <a href={isArabic ? "/ar/chat/" : "/en/chat/"}>{isArabic ? "ابدأ الاستكشاف" : "Start exploring"}</a>
        </div>
        <span class="footer-credit">
          {isArabic
            ? "صنع بحب ❤️ ضمن مبادرة أكاديمية طويق وقوقل للمطورين"
            : "Made with love ❤️ as part of the Tuwaiq Academy and Google for Developers initiative"}
        </span>
      </footer>
    </main>
  </body>
</html>
