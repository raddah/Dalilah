{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalilah",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dalilah-db",
      "database_id": "eb4a8238-50cf-4c37-9001-595f601d9f82",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "dalilah-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "1f6da7a82e674bdcbef26820b58a92a2"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_APP_ORIGIN": "https://replace-with-your-domain.example"
  }
}
